// MIMO — Prisma schema
// Fase 1: arquitectura de datos completa del marketplace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  BUSINESS
  ADMIN
}

enum BusinessRole {
  OWNER
  STAFF
}

enum BusinessStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum OccasionType {
  OCCASION
  EMOTION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

// Per-vendor status within a multi-business order, so each business can
// manage its own line items independently of the overall order status.
enum OrderItemStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryWindow {
  ASAP
  MORNING // 9AM-12PM
  MIDDAY // 12PM-3PM
  AFTERNOON // 3PM-6PM
  EVENING // 6PM-9PM
}

enum PaymentProvider {
  CARD
  PAYPAL
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/** Cuánto de un `Payment` (que puede cubrir varios negocios en un carrito
 * multi-tienda) le corresponde a cada negocio, y qué pasó con esa parte:
 * PENDING hasta que el negocio confirma o cancela su parte del pedido;
 * PAID_OUT cuando ya se le mandó por PayPal Payouts; PAYOUT_FAILED si
 * confirmó pero no se le pudo pagar (ej. no tiene `paypalEmail` cargado, ver
 * `Business.paypalEmail`); REFUNDED si no confirmó a tiempo y se le
 * reembolsó esa parte al comprador. Solo aplica a pagos ya capturados
 * (PayPal hoy) — CASH no genera `PaymentSplit`. */
enum PaymentSplitStatus {
  PENDING
  PAID_OUT
  PAYOUT_FAILED
  REFUNDED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FavoriteTargetType {
  PRODUCT
  BUSINESS
}

enum ImportantDateType {
  ANNIVERSARY
  BIRTHDAY
  MOTHERS_DAY
  FATHERS_DAY
  GRADUATION
  OTHER
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_IN_PROGRESS
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  IMPORTANT_DATE_REMINDER
  BUSINESS_APPROVED
  BUSINESS_SUSPENDED
  REVIEW_RECEIVED
  PROMOTION
  SYSTEM
  ORDER_MESSAGE
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED
}

enum ReportTargetType {
  PRODUCT
  BUSINESS
  REVIEW
  USER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum BusinessPlan {
  FREE
  PRO
  PREMIUM
}

enum CoverageRequestStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ─────────────────────────────────────────────────────────────────────────
// UBICACIÓN — El Salvador (departamentos / municipios), no solo San Salvador
// ─────────────────────────────────────────────────────────────────────────

model Department {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  slug           String         @unique
  municipalities Municipality[]
  createdAt      DateTime       @default(now())

  @@map("departments")
}

model Municipality {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  slug         String
  departmentId String         @db.Uuid
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  latitude     Float?
  longitude    Float?
  // Los antiguos municipios (pre-reforma territorial 2021) que hoy quedaron
  // agrupados dentro de este municipio — solo informativo (ej. "San Salvador
  // Centro" incluye "Mejicanos", "Ciudad Delgado"...), no es una entidad
  // seleccionable propia: no hace falta un nivel más de jerarquía para que
  // un negocio elija su zona de entrega.
  districts    String[]       @default([])
  businesses     Business[]
  deliveryZones  DeliveryZone[]
  orderAddresses OrderAddress[]
  coverageRequests CoverageRequest[]
  createdAt    DateTime       @default(now())

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@map("municipalities")
}

// ─────────────────────────────────────────────────────────────────────────
// USUARIOS Y AUTENTICACIÓN
// ─────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?
  image         String?
  role          UserRole  @default(USER)

  accounts Account[]
  sessions Session[]

  businessMemberships BusinessUser[]
  orders              Order[]
  reviews             Review[]
  favorites           Favorite[]
  importantDates      ImportantDate[]
  notifications       Notification[]
  aiConversations     AIConversation[]
  aiRecommendations   AIRecommendation[]
  reports             Report[]
  pushTokens          PushToken[]
  webPushSubscriptions WebPushSubscription[]
  coverageRequests    CoverageRequest[]
  authTokens          AuthToken[]
  orderMessages       OrderMessage[]
  giftRegistries      GiftRegistry[]
  groupGifts          GroupGift[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@map("users")
}

// Auth.js (NextAuth) adapter models — preparados para agregar Google/Apple
// login y sesiones de la futura app móvil sin tocar el resto del esquema.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/**
 * Tokens de un solo uso para verificar correo y restablecer contraseña —
 * separado de `VerificationToken` (que es la tabla del adapter de Auth.js,
 * hoy sin usar porque no hay un provider de Email/magic-link configurado)
 * para no mezclar responsabilidades. Se guarda el hash del token, nunca el
 * valor en texto plano — igual que `passwordHash` en `User`.
 */
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// Tokens de push notification para la futura app React Native / Expo.
model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // "ios" | "android" | "web"
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_tokens")
}

/**
 * Suscripción real de Web Push (navegador) — forma distinta a `PushToken`
 * (pensado para un token opaco de FCM/APNs de una futura app nativa), por
 * eso un modelo aparte en vez de forzar `endpoint`+`p256dh`+`auth` adentro
 * de un solo campo `token` de texto. `endpoint` es único: un mismo
 * navegador/dispositivo tiene una sola suscripción activa por vez.
 */
model WebPushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("web_push_subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────
// NEGOCIOS
// ─────────────────────────────────────────────────────────────────────────

model Business {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  description String?        @db.Text
  logoUrl     String?
  coverUrl    String?
  phone       String?
  whatsapp    String?
  instagram   String?
  facebook    String?
  tiktok      String?

  status   BusinessStatus @default(PENDING)
  verified Boolean        @default(false)
  isDemo   Boolean        @default(false)
  plan     BusinessPlan   @default(FREE)

  // % que se queda MIMO de cada venta (0-100). Se fija al aprobar el negocio
  // (ver `updateAdminBusiness`: los primeros 10 negocios reales aprobados
  // entran en 0% de prueba, del 11 en adelante entran directo en 10%) y el
  // admin lo puede editar después para mover a un negocio de la prueba a
  // comisión plena. `paypalEmail` es a dónde le mandamos su parte con
  // PayPal Payouts cuando confirma un pedido — ver "Diseño: pagos con
  // PayPal" en el README.
  commissionRate Decimal @default(10) @db.Decimal(5, 2)
  paypalEmail    String?

  municipalityId       String?  @db.Uuid
  municipality         Municipality? @relation(fields: [municipalityId], references: [id])
  addressLine          String?
  latitude             Float?
  longitude            Float?
  openingHours         Json? // { mon: ["09:00","18:00"], ... }
  preparationTimeMinutes Int    @default(60)

  members          BusinessUser[]
  products         Product[]
  deliveryZones    DeliveryZone[]
  reviews          Review[]
  favorites        Favorite[]
  promotions       Promotion[]
  coverageRequests CoverageRequest[]
  paymentSplits    PaymentSplit[]

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([municipalityId])
  @@map("businesses")
}

model BusinessUser {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_users")
}

model DeliveryZone {
  id                  String        @id @default(uuid()) @db.Uuid
  businessId          String        @db.Uuid
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  municipalityId      String?       @db.Uuid
  municipality        Municipality? @relation(fields: [municipalityId], references: [id])
  deliveryFee         Decimal       @default(0) @db.Decimal(10, 2)
  estimatedMinutes    Int           @default(60)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([businessId])
  @@index([municipalityId])
  @@map("delivery_zones")
}

/**
 * Cuando alguien intenta comprarle a un negocio que no tiene una
 * `DeliveryZone` activa para su municipio, el checkout no lo deja avanzar
 * (sección: la cobertura queda a criterio de cada negocio) pero le ofrece
 * dejar esta señal de demanda — así el negocio/admin ve dónde conviene
 * abrir cobertura nueva.
 */
model CoverageRequest {
  id             String                @id @default(uuid()) @db.Uuid
  businessId     String                @db.Uuid
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  municipalityId String                @db.Uuid
  municipality   Municipality          @relation(fields: [municipalityId], references: [id])
  userId         String?               @db.Uuid
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  status         CoverageRequestStatus @default(OPEN)
  createdAt      DateTime              @default(now())

  @@index([businessId])
  @@index([municipalityId])
  @@index([status])
  @@map("coverage_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// CATÁLOGO
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  emoji       String?
  description String?
  parentId    String?   @db.Uuid
  parent      Category? @relation("CategoryToParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToParent")
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId])
  @@map("categories")
}

// Cubre tanto ocasiones (cumpleaños, aniversario) como categorías
// emocionales (te amo, perdón, gracias) — ver sección 14.
model Occasion {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  slug      String           @unique
  emoji     String?
  type      OccasionType     @default(OCCASION)
  products  ProductOccasion[]
  createdAt DateTime         @default(now())

  @@map("occasions")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @db.Uuid
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  String        @db.Uuid
  category    Category      @relation(fields: [categoryId], references: [id])

  name        String
  slug        String        @unique
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?   @db.Decimal(10, 2)
  currency    String        @default("USD")

  stock                  Int     @default(0)
  isPersonalizable       Boolean @default(false)
  availableToday         Boolean @default(true)
  preparationTimeMinutes Int     @default(60)

  status ProductStatus @default(ACTIVE)
  isDemo Boolean        @default(false)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  salesCount  Int   @default(0)

  images       ProductImage[]
  occasions    ProductOccasion[]
  orderItems   OrderItem[]
  reviews      Review[]
  favorites    Favorite[]
  aiRecommendedIn AIRecommendationProduct[]
  registryItems GiftRegistryItem[]
  groupGifts    GroupGift[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductOccasion {
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasionId String   @db.Uuid
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@index([occasionId])
  @@map("product_occasions")
}

// ─────────────────────────────────────────────────────────────────────────
// CUPONES
// ─────────────────────────────────────────────────────────────────────────

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/**
 * Cupones de plataforma (no por negocio) — un código aplica al subtotal de
 * TODO el carrito, sin importar cuántos negocios tenga. El descuento se
 * reparte proporcionalmente entre los negocios del pedido al calcular los
 * `PaymentSplit` (ver `order-service.ts`), así ningún negocio "absorbe"
 * todo el cupón y la comisión de MIMO nunca puede quedar negativa incluso
 * con negocios en la prueba de 0%.
 */
model Coupon {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String?

  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2) // % (0-100) si PERCENTAGE, USD si FIXED_AMOUNT

  minSubtotal    Decimal? @db.Decimal(10, 2)
  maxUses        Int?
  maxUsesPerUser Int?
  usedCount      Int      @default(0)

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────
// PEDIDOS
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique
  buyerId     String      @db.Uuid
  buyer       User        @relation(fields: [buyerId], references: [id])

  buyerName  String
  buyerEmail String
  buyerPhone String

  status       OrderStatus @default(PENDING)
  subtotal     Decimal     @db.Decimal(10, 2)
  deliveryFee  Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  currency     String      @default("USD")

  // Cupón de plataforma aplicado (opcional) — `couponCode` queda guardado
  // en el pedido aunque el cupón se borre/desactive después, para que el
  // historial no pierda el dato de qué se usó.
  couponCode     String?
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  isSurpriseMode        Boolean @default(false)
  surpriseInstructions  String? @db.Text
  hideBuyerFromRecipient Boolean @default(false)

  items      OrderItem[]
  address    OrderAddress?
  payment    Payment?
  reviews    Review[]
  messages   OrderMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

// Cada línea pertenece a un negocio; así el pedido queda dividido
// internamente por vendedor aunque el carrito sea multi-tienda.
model OrderItem {
  id         String          @id @default(uuid()) @db.Uuid
  orderId    String          @db.Uuid
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String          @db.Uuid
  product    Product         @relation(fields: [productId], references: [id])
  businessId String          @db.Uuid

  quantity     Int     @default(1)
  unitPrice    Decimal @db.Decimal(10, 2)
  personalization Json? // { message, dedication, color, size, cardText }

  status OrderItemStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([businessId])
  @@index([productId])
  @@map("order_items")
}

enum OrderMessageSender {
  CUSTOMER
  BUSINESS
}

/**
 * Conversación por pedido+negocio — no por `OrderItem`: un mismo negocio
 * puede tener varias líneas en el mismo pedido (carrito multi-tienda) y son
 * la misma entrega, la misma conversación ("no encuentro la casa" aplica a
 * los dos productos, no a uno). `businessId` es un id suelto sin relación
 * formal de Prisma a propósito — mismo patrón que `OrderItem.businessId`
 * en este archivo, no una inconsistencia.
 */
model OrderMessage {
  id         String             @id @default(uuid()) @db.Uuid
  orderId    String             @db.Uuid
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  businessId String             @db.Uuid
  senderId   String             @db.Uuid
  sender     User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole OrderMessageSender
  body       String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([orderId, businessId])
  @@map("order_messages")
}

model OrderAddress {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipientName  String
  recipientPhone String
  addressLine    String
  reference      String?
  municipalityId String?       @db.Uuid
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
  latitude       Float?
  longitude      Float?

  deliveryDate     DateTime
  deliveryWindow   DeliveryWindow @default(ASAP)
  deliveryInstructions String?    @db.Text

  createdAt DateTime @default(now())

  @@map("order_addresses")
}

model Payment {
  id         String          @id @default(uuid()) @db.Uuid
  orderId    String          @unique @db.Uuid
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   PaymentProvider
  status     PaymentStatus   @default(PENDING)
  amount     Decimal         @db.Decimal(10, 2)
  currency   String          @default("USD")
  providerOrderId   String? // id de orden de PayPal (checkout), previo a la captura
  providerReference String? // id de la captura de PayPal una vez cobrado
  paidAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  splits PaymentSplit[]

  @@map("payments")
}

model PaymentSplit {
  id         String  @id @default(uuid()) @db.Uuid
  paymentId  String  @db.Uuid
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  businessId String  @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])

  grossAmount      Decimal            @db.Decimal(10, 2)
  commissionRate   Decimal            @db.Decimal(5, 2)
  commissionAmount Decimal            @db.Decimal(10, 2)
  netAmount        Decimal            @db.Decimal(10, 2)
  status           PaymentSplitStatus @default(PENDING)
  payoutReference  String?
  refundReference  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentId, businessId])
  @@index([businessId])
  @@map("payment_splits")
}

// ─────────────────────────────────────────────────────────────────────────
// REVIEWS Y FAVORITOS
// ─────────────────────────────────────────────────────────────────────────

model Review {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String @db.Uuid
  order      Order  @relation(fields: [orderId], references: [id])
  productId  String? @db.Uuid
  product    Product? @relation(fields: [productId], references: [id])
  businessId String? @db.Uuid
  business   Business? @relation(fields: [businessId], references: [id])

  productRating  Int?
  businessRating Int?
  deliveryRating Int?
  comment        String? @db.Text
  images         String[] @default([])

  status ModerationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([businessId])
  @@index([orderId])
  @@map("reviews")
}

model Favorite {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavoriteTargetType
  productId  String?            @db.Uuid
  product    Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId String?            @db.Uuid
  business   Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([userId, productId])
  @@unique([userId, businessId])
  @@map("favorites")
}

// ─────────────────────────────────────────────────────────────────────────
// LISTAS DE REGALOS
// ─────────────────────────────────────────────────────────────────────────

/**
 * Lista pública ("registro de regalos") que alguien arma para una boda,
 * baby shower, cumpleaños, etc. — la comparte con un link y la gente le
 * compra de ahí sin duplicar. Importante: MIMO no bloquea la compra real,
 * solo coordina quién dice que va a traer qué — "reservar" es una
 * declaración social, no un pago ni una garantía (ver README, "Diseño:
 * listas de regalos", y la regla de no fingir funcionalidad que no existe).
 */
model GiftRegistry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String   @unique
  title     String
  eventType String?
  eventDate DateTime?
  message   String?  @db.Text
  isActive  Boolean  @default(true)

  items GiftRegistryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("gift_registries")
}

model GiftRegistryItem {
  id         String       @id @default(uuid()) @db.Uuid
  registryId String       @db.Uuid
  registry   GiftRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)
  productId  String       @db.Uuid
  product    Product      @relation(fields: [productId], references: [id])
  note       String?

  reservedByName String?
  reservedAt     DateTime?

  createdAt DateTime @default(now())

  @@unique([registryId, productId])
  @@index([registryId])
  @@map("gift_registry_items")
}

// ─────────────────────────────────────────────────────────────────────────
// COLECTAS GRUPALES ("VAQUITA")
// ─────────────────────────────────────────────────────────────────────────

enum GroupGiftStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum GroupGiftContributionStatus {
  PENDING
  PAID
  REFUNDED
}

/**
 * Varias personas aportan plata real (vía PayPal, cada aporte es un cobro
 * de verdad) para un regalo puntual. MIMO NO arma un pedido automático al
 * completarse — sería fingir una integración que no existe (mezclar fondos
 * ya cobrados con el flujo normal de checkout, que cobra el envío recién
 * al elegir dirección, generaría un descuadre). En cambio, al completarse
 * se le manda todo lo recaudado al organizador por PayPal Payouts (mismo
 * mecanismo que ya se usa para pagarle a los negocios) para que sea él
 * quien haga la compra real — ver README, "Diseño: colectas grupales".
 */
model GroupGift {
  id          String   @id @default(uuid()) @db.Uuid
  organizerId String   @db.Uuid
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  slug        String   @unique
  title       String
  message     String?  @db.Text
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])

  targetAmount         Decimal   @db.Decimal(10, 2)
  deadline             DateTime?
  organizerPaypalEmail String

  status          GroupGiftStatus @default(OPEN)
  payoutReference String?

  contributions GroupGiftContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@map("group_gifts")
}

model GroupGiftContribution {
  id              String                      @id @default(uuid()) @db.Uuid
  groupGiftId     String                      @db.Uuid
  groupGift       GroupGift                   @relation(fields: [groupGiftId], references: [id], onDelete: Cascade)
  contributorName String
  amount          Decimal                     @db.Decimal(10, 2)
  status          GroupGiftContributionStatus @default(PENDING)
  paypalOrderId   String?
  captureId       String?
  refundReference String?

  createdAt DateTime @default(now())

  @@index([groupGiftId])
  @@map("group_gift_contributions")
}

// ─────────────────────────────────────────────────────────────────────────
// FECHAS IMPORTANTES, NOTIFICACIONES, PROMOCIONES
// ─────────────────────────────────────────────────────────────────────────

model ImportantDate {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ImportantDateType
  label          String
  date           DateTime
  recipientName  String?
  remindDaysBefore Int             @default(7)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@map("important_dates")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Promotion {
  id             String                @id @default(uuid()) @db.Uuid
  businessId     String?               @db.Uuid
  business       Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code           String?               @unique
  title          String
  description    String?
  discountType   PromotionDiscountType
  discountValue  Decimal               @db.Decimal(10, 2)
  isFeatured     Boolean               @default(false)
  isActive       Boolean               @default(true)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([businessId])
  @@index([isActive])
  @@map("promotions")
}

// ─────────────────────────────────────────────────────────────────────────
// IA
// ─────────────────────────────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  messages  Json // [{ role, content, createdAt }]
  context   Json? // destinatario, ocasión, presupuesto, gustos, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@map("ai_conversations")
}

model AIRecommendation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId      String?
  requestText    String   @db.Text
  parsedIntent   Json // { recipient, relationship, occasion, budget, likes, location, date }
  products       AIRecommendationProduct[]
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("ai_recommendations")
}

// Productos reales de la base de datos que la IA recomendó, con la
// explicación mostrada al usuario — nunca datos inventados por el modelo.
model AIRecommendationProduct {
  id                 String           @id @default(uuid()) @db.Uuid
  recommendationId   String           @db.Uuid
  recommendation     AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  productId          String           @db.Uuid
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  position           Int              @default(0)
  explanation        String           @db.Text
  createdAt          DateTime         @default(now())

  @@index([recommendationId])
  @@index([productId])
  @@map("ai_recommendation_products")
}

// ─────────────────────────────────────────────────────────────────────────
// MODERACIÓN
// ─────────────────────────────────────────────────────────────────────────

model Report {
  id          String           @id @default(uuid()) @db.Uuid
  reporterId  String           @db.Uuid
  reporter    User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  ReportTargetType
  targetId    String           @db.Uuid
  reason      String
  description String?          @db.Text
  status      ReportStatus     @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────
// PUBLICIDAD
// ─────────────────────────────────────────────────────────────────────────

/**
 * Banners promocionales que el admin sube para el home (sección "Diseño:
 * banners promocionales"). `linkUrl` es opcional porque un banner puede ser
 * puramente informativo; cuando existe, admite tanto rutas internas
 * ("/regalos?categoria=flores") como URLs externas.
 */
model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("banners")
}
