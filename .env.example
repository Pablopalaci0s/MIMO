# Copiar este archivo como .env en la raíz del monorepo y completar los valores.
# Tanto apps/web (Next.js) como packages/database (Prisma CLI) leen este único
# archivo — ver apps/web/next.config.ts y los scripts de packages/database.

# ── Base de datos ────────────────────────────────────────────────────────
# Postgres local, Docker, o un proveedor administrado (Neon, Supabase, RDS...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mimo?schema=public"

# ── Auth.js / NextAuth ───────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET="reemplazar-con-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Login con Google/Facebook: opcional — sin estas claves, esos botones ni
# se muestran (nunca un botón que no funcione, ver CLAUDE.md regla 5). Con
# ambas claves de un proveedor puestas, el botón aparece solo.
# Google: console.cloud.google.com → crear proyecto → "APIs & Services" →
# "Credentials" → "Create OAuth client ID" (tipo "Web application") →
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: developers.facebook.com → crear app (tipo "Consumer") → agregar
# el producto "Facebook Login" → Settings → Valid OAuth Redirect URI:
# {NEXTAUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── IA (packages/ai) ─────────────────────────────────────────────────────
# Opcional: sin esta clave, MIMO sigue funcionando con el motor de
# recomendaciones basado en reglas (sección 33 del spec).
ANTHROPIC_API_KEY=""

# ── Email (recuperar contraseña, verificar correo) ────────────────────────
# Opcional para desarrollo: sin esta clave, los correos se loguean a
# consola en vez de enviarse — el link para probar el flujo aparece ahí.
# Crear cuenta gratis en https://resend.com, verificar un dominio (o usar
# su dominio de pruebas onboarding@resend.dev para arrancar) y generar una
# API key.
RESEND_API_KEY=""
EMAIL_FROM="MIMO <onboarding@resend.dev>"

# ── Monitoreo de errores (Sentry) ──────────────────────────────────────────
# Opcional: sin SENTRY_DSN, no se manda nada a Sentry (los errores igual se
# loguean estructurados a consola). Crear cuenta gratis en sentry.io, crear
# un proyecto Next.js, y copiar su DSN acá dos veces (una para el server,
# otra con prefijo NEXT_PUBLIC_ para que el navegador la pueda leer).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Solo hacen falta si querés que el build suba source maps a Sentry:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── Notificaciones push (navegador) ─────────────────────────────────────────
# Opcional: sin estas dos claves, el botón "Activar notificaciones" ni se
# muestra (nunca uno que no funcione). Generar el par con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública lleva NEXT_PUBLIC_ porque el navegador la necesita para
# suscribirse — es pública por diseño, no es un secreto.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que Apple/Google piden poder usar si un push se manda mal —
# cualquier mailto: o https: real sirve, no hace falta que reciba nada.
VAPID_SUBJECT="mailto:soporte@mimo.sv"

# ── Cron de fechas importantes ──────────────────────────────────────────────
# Protege /api/cron/fechas-importantes (ver
# .github/workflows/cron-fechas-importantes.yml). Generar con:
#   openssl rand -base64 24
# Sin esta variable, el endpoint rechaza todo — no hay versión "abierta".
CRON_SECRET=""

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
