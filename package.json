{
  "name": "mimo",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "dotenv -e .env -- prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "db:migrate:deploy": "dotenv -e .env -- prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "db:studio": "dotenv -e .env -- prisma studio --schema=packages/database/prisma/schema.prisma",
    "db:seed": "dotenv -e .env -- tsx packages/database/prisma/seed.ts"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
